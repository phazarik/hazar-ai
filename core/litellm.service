# ----------------------------------------------------------------------------
# Optional systemd service reference
#
# Runs LiteLLM in the background and reads keys from the env file.
# This reference assumes ~/.ai-setup; setup.py writes actual paths.
# Manual startup through start.sh does not require systemd.
# ----------------------------------------------------------------------------

[Unit]
Description=LiteLLM proxy
After=network.target

# Actual installation paths are generated by setup.py.
[Service]
WorkingDirectory=%h/.ai-setup
Environment=PYTHONPATH=%h/.ai-setup
EnvironmentFile=%h/.ai-setup/core/litellm.env
ExecStart=%h/.local/bin/litellm --config %h/.ai-setup/core/config.yaml --port 4000
# Restart after a failure rather than a normal manual stop.
Restart=on-failure

[Install]
WantedBy=default.target
