# ----------------------------------------------------------------------------
# Provider keys and gateway settings
#
# Template for the private env file created by setup.py.
# Leave unused provider keys empty; fill only providers in the model config.
# The master key protects the local gateway and is generated during setup.
# ----------------------------------------------------------------------------

OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
TAVILY_API_KEY=""
# setup.py or start.sh generates the local gateway credential.
LITELLM_MASTER_KEY=""
